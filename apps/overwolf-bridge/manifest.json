{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "OHMM Overwolf Bridge",
    "author": "OHMM",
    "version": "0.1.0",
    "minimum-overwolf-version": "0.226.0",
    "description": "Captures Once Human gear screenshots and forwards them to the local OHMM vision service.",
    "icon": "assets/icon.png"
  },
  "permissions": ["Hotkeys", "Media"],
  "data": {
    "start_window": "background",
    "windows": {
      "background": {
        "file": "src/background.html",
        "is_background_page": true
      },
      "overlay": {
        "file": "src/overlay.html",
        "transparent": true,
        "resizable": false,
        "show_in_taskbar": false,
        "size": {
          "width": 420,
          "height": 96
        },
        "start_position": {
          "top": 72,
          "left": 72
        }
      }
    },
    "hotkeys": {
      "import_gear_hotkey": {
        "title": "Import gear screenshot",
        "action-type": "custom",
        "default": "Ctrl+Shift+I",
        "passthrough": true
      }
    }
  }
}
