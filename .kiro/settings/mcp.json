{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "disabled": false,
      "autoApprove": [
        "browser_navigate",
        "browser_snapshot",
        "browser_click",
        "browser_type",
        "browser_tab_list",
        "browser_tab_new",
        "browser_tab_close",
        "browser_resize",
        "browser_screenshot",
        "browser_take_screenshot",
        "browser_take_screenshot",
        "browser_evaluate",
        "browser_take_screenshot",
        "browser_press_key",
        "browser_wait_for"
      ]
    }
  }
}