    "test:conditional:effects": "tsx src/engine/conditionalEffectSmokeTest.ts",
    "test:assumption:control": "tsx src/engine/assumptionControlSmokeTest.ts",
    "test:build:comparison": "tsx src/ui/buildComparisonSmokeTest.ts",
    "test:build:persistence": "tsx src/ui/buildPersistenceSmokeTest.ts",
    "test:chef-rex": "tsx src/ui/chefRexSmokeTest.ts",
