    "audit:data-integrity": "tsx scripts/audit-build-data-integrity.ts",
    "check:stale": "tsx scripts/check-stale.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "validate:images": "tsx scripts/validate-images.ts",
    "parse:bindict": "python scripts/bindict_parser.py",
    "decrypt:npk-entry": "python scripts/npk_decrypt_helpers.py",
    "extract:script-npk": "python scripts/extract_script_npk.py",
    "read:npk": "python scripts/npk_archive_reader.py",
