    "test:ui:domain": "npm run test:chef-rex && npm run test:loadout:options && npm run test:buff:recovered",
    "test:all": "npm run test:scorer && npm run test:combat && npm run test:combat:external-research && npm run test:registry:validation && npm run test:staging:validation && npm run test:formula:bridge && npm run test:pvp:mitigation && npm run test:combat:output && npm run test:formula:damage:integration && npm run test:conditional:effects && npm run test:assumption:control && npm run test:build:comparison && npm run test:build:persistence && npm run test:ammo:compatibility && npm run test:ui:domain && npm run audit:privacy"
