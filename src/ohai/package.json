    "test:formula:leaf-resolvers": "tsx src/engine/officialFormulaLeafResolversSmokeTest.ts",
    "test:formula:tag-tables": "tsx src/engine/officialFormulaTagTablesSmokeTest.ts",
    "test:formula:stat-bridge": "tsx src/engine/officialFormulaStatBridgeSmokeTest.ts",
    "test:formula:validation-harness": "tsx src/engine/officialFormulaValidationSmokeTest.ts",
    "test:ammo:compatibility": "tsx src/ui/registries/ammoCompatibilitySmokeTest.ts",
    "test:calibration:recovered": "tsx src/ui/registries/weaponCalibrationRegistrySmokeTest.ts",
    "test:buff:recovered": "tsx src/ui/data/recovered/__tests__/buffTagPropMap.smokeTest.ts && tsx src/ui/data/recovered/__tests__/buffLogicTreeBridge.smokeTest.ts && tsx src/ui/data/recovered/__tests__/officialAttributes.smokeTest.ts && tsx src/ui/data/recovered/__tests__/officialRuntime.smokeTest.ts && tsx src/ui/data/recovered/__tests__/officialWeaponStatAdapter.smokeTest.ts",
