    "test:combat:metadata": "tsx src/engine/combatMetadataSmokeTest.ts",
    "test:combat:formula": "tsx src/engine/formulaSmokeTest.ts",
    "test:combat:validation": "tsx src/engine/formulaValidationSmokeTest.ts",
    "test:combat:observation": "tsx src/engine/observationSmokeTest.ts",
