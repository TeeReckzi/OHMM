    "pretest:all": "npm run typecheck && npm run typecheck:ui",
    "dev": "vite --config vite.config.mjs",
    "build": "vite build --config vite.config.mjs",
    "deploy": "vite build --config vite.config.mjs && gh-pages -d dist-ui -y",
    "preview": "vite preview --config vite.config.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "tsc --noEmit -p tsconfig.ui.json",
