  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "exceljs": "^3.4.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^8.0.16",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "gh-pages": "^6.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
