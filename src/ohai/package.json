    "extract:weapons": "tsx src/parsers/extractWeapons.ts",
    "extract:armor": "tsx src/parsers/extractArmor.ts",
    "extract:mod-core": "tsx src/parsers/extractModCoreEffects.ts",
    "extract:external-references": "tsx src/parsers/importExternalReferences.ts",
