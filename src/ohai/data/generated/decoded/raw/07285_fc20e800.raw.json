  },
  "records": [
    {
      "content": {
        "lan_translate": [
          "勇气通往天堂，怯懦通往地狱。_$S@TIDS$_52|0"
        ]
      },
      "level": 1
    },
    {
      "content": {
        "lan_translate": [
          "人生如棋，落子无悔。_$S@TIDS$_52|0"
        ]
      },
      "level": 1
    },
    {
      "content": {
        "lan_translate": [
          "彩虹在远处地平线上浮现，旷野更加美丽。_$S@TIDS$_52|0"
        ]
      },
      "level": 1
    },
    {
      "content": {
        "lan_translate": [
          "朝着月亮出发，即使迷失也能与星河同眠。_$S@TIDS$_52|0"
        ]
      },
      "level": 1
    },
    {
      "content": {
        "lan_translate": [
          "汪洋之中，要寻找陆地才能构建心中理想。_$S@TIDS$_52|0"
        ]
      },
      "level": 1
    },
    {
      "content": {
        "lan_translate": [
          "人生只有一次，当然要活得比谁都炽热璀璨。_$S@TIDS$_52|0"
        ]
      },
      "level": 1
    },
    {
      "content": {
        "lan_translate": [
          "如果我祝你生日快乐，你愿意把今天当作你的生日吗？_$S@TIDS$_52|0"
        ]
      },
      "level": 1
    },
    {
      "content": {
        "lan_translate": [
          "错过落日余晖，还有满天繁星可以期待。_$S@TIDS$_52|0"
        ]
      },
      "level": 1
    },
    {
      "content": {
        "lan_translate": [
          "如果云在唱歌，那是有人在为和你的相遇心动。_$S@TIDS$_52|0"
        ]
      },
      "level": 1
    },
    {
      "content": {
        "lan_translate": [
          "人人都在空手和命运较量，赢下的人会启程去更远的远方。_$S@TIDS$_52|0"
        ]
      },
      "level": 1
    },
    {
      "content": {
        "lan_translate": [
          "种瓜得瓜，种豆得豆。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "起床不顺利？试试关掉闹钟。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "万事开头难，然后中间难，最后结尾难。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "生活就是：生下来，活下去。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "人生没有彩排，每天都是直播。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "祝你节日快乐，每天都快乐！_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "0是结束，0也是开始。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "事事顺心，年年有余。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "想要站得稳，就得找到人生的平衡点。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "每个微小的胜利都值得庆祝。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "友谊第一，比赛第二，这是以和为贵。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "比赛第一，友谊第二，这是竞技精神。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "要记得去看一次免费的日出。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "群星间一定有属于你的那颗引路明星。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "幸福的光芒总会从细小裂缝里渗入。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "黑暗里不想回头，就继续前行，原地打转没有未来。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "从今天往前的每一天，都是往后人生之书的序章。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "循梦而行，向阳而生。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "当前的生活或许有些沉闷压抑，但跑起来总是有风的。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "爱人先爱己。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "你是宇宙的奇迹。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "如果没有天赋，那就一直重复。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "前进一寸是勇气，后退一尺是豁达。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "永远浪漫，永远疯狂，永远清澈，永远真挚。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "有人偷偷爱你，只是你一无所知。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "我想跃进人海拥抱你。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "爱的光是柔软的，会接住你的每次跌落。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "爱是一个动词，不需要解释，行动会表示。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "心跳与呼吸同频的每分每秒都在诉说爱意。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "如果你是一朵鲜花，好运就会化作蝴蝶围绕着你。_$S@TIDS$_52|0"
        ]
      },
      "level": 2
    },
    {
      "content": {
        "lan_translate": [
          "表象的孤独可不是时尚单品。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "坚持本心才能到达目的地。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "退后一米，开阔一程。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "现在是行动的时候。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "不如换个方向，转头就能看到冲天巨楔。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "努力不会白费。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "会获得意料之外的顺利。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "相信自己的判断，人定胜天。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "为什么不去做？做你想做的。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "一笑置之，它是个纸老虎。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "赚钱如捉鬼，越捉越有。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "别担心，最困难的日子熬过去了，剩下的就是好运气。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "时机未到，静候佳音。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "这是一个完美的第六感，相信你的直觉。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "走过的每段路程都作数，付出的每份努力都有用。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "放手一搏，结局会走上你希望的方向。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "停下来，听取他人的建议，这很有用。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "坚持就是胜利，光明就在前方。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "东风转南风，风向已变。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "答案在你心中，相信它。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "细节决定成败。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "真相很快浮出水面，不必急于做什么决定。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "抓住机会，它即将像流星一样划过。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "明天总比今天好。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "上天会把你送到充满爱意的家庭。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "心有所期，忙而不茫。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "人生没有太晚的开始，只有不开始。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "一切刚刚好，眼前已是上天最好的安排。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "世界因为有勇士的挺身前行而更加美好绚丽。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "登高望远，才能见大江大河奔流向前。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "前途似海，来日方长。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "努力和收获有时差。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "花期不同，不必焦虑。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "心平气和，从容应对，兵来将挡，水来土掩。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "明天比今天好，这是美好的希望；今天比昨天好，这是希望的具象。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "没人可以回到过去，但所有人都可以从现在开始。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "如果事与愿违，那就是上天另作安排。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "没什么能难倒你。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "好运眷顾勇士。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "行动是最直接的回应。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "生活没有深意，自己喜欢就是真意。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "黑夜总会过去，白昼总会到来。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "面对梦想，要不遗余力地追求。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "冷静点，别着急，慢慢来。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "越努力越幸运。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "在陌生的领域不要随意开口展示无知。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "要大声说出爱。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "恭喜发财！_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "大人的童真是宝贵的财富。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "逆境中坚强，顺境中谦逊。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "友谊地久天长。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "停止现在的思考，放空自己，想点别的。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "当下并不是合适的时机。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "在事业上勇攀高峰。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "需要一个携手前行的挚友，相互扶持。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "一点小事而已，不必挂怀。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "不能改变别人的看法，就改变自己的想法。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "你听到了吗？清风送来祝福。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "不要害怕变化，要拥抱它。_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
    {
      "content": {
        "lan_translate": [
          "心想事成！_$S@TIDS$_52|0"
        ]
      },
      "level": 3
    },
