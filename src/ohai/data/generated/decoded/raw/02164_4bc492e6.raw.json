      "rare_colloction_reward": []
    },
    {
      "colloction_desc": {
        "lan_translate": [
          "“迷途者”在路上不知疲倦地奔走。仿佛在重演浩劫前平凡的每一日。\n往日的世界已经沉沦，如今它们没有了去处，也找不到来时的路。_$S@TIDS$_c10|0"
        ]
      },
      "colloction_link_item": 30331018,
      "colloction_link_rare_item": 30331039,
      "colloction_name": {
