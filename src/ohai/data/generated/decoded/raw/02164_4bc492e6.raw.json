    {
      "colloction_desc": {
        "lan_translate": [
          "\"掘者\"自由地在地下穿行，土层和岩石对它而言就如流水一般。\n它们能敏锐地感知震动，从猎物脚下破土而出，以坚硬的钻头将其撕碎。_$S@TIDS$_c10|0"
        ]
      },
      "colloction_link_item": 30331016,
      "colloction_link_rare_item": 30331037,
      "colloction_name": {
