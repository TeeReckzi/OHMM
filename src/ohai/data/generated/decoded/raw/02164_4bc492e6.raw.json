    {
      "colloction_desc": {
        "lan_translate": [
          "“监视者\"勤勤恳恳提供着照明，一如它们出厂时一般。\n你为什么还在休息？难道不知道要努力吗？_$S@TIDS$_c10|0"
        ]
      },
      "colloction_link_item": 30331015,
