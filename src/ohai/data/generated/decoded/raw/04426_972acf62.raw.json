      "accepted_trigger": 100024879,
      "character_desc": {
        "lan_translate": [
          "我们希望堡垒乐队将要前往雪国演出啦！启程之前，能不能委托你替我们收集点物资呢？_$S@TIDS$_cb8|0"
        ]
