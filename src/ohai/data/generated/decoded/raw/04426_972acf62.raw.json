    {
      "accepted_trigger": 100025828,
      "character_desc": {
        "lan_translate": [
          "前往雪国之前，我们一起收集更多情报吧！那些上位者，似乎是问路的好目标。_$S@TIDS$_cb8|0"
        ]
      },
      "character_name": {
        "lan_translate": [
