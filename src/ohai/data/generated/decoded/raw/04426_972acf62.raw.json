    {
      "accepted_trigger": 100024903,
      "character_desc": {
        "lan_translate": [
          "武器，弹药，多多益善！收集物资的事，就要继续拜托你啦！_$S@TIDS$_cb8|0"
        ]
      },
      "character_name": {
        "lan_translate": [
